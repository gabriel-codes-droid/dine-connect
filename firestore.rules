rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function isSuperAdmin() {
      return signedIn() && userProfile().role == 'super-admin';
    }

    function isRestaurantAdmin() {
      return signedIn() && userProfile().role == 'restaurant-admin';
    }

    function isStaff() {
      return isSuperAdmin() || isRestaurantAdmin();
    }

    function ownsRestaurant(restaurantId) {
      return signedIn()
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['customer', 'restaurant-admin'];
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if isSuperAdmin();
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if isSuperAdmin();
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if signedIn()
        && (request.resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow update, delete: if isSuperAdmin() || resource.data.ownerId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (isSuperAdmin()
          || resource.data.customerId == request.auth.uid
          || ownsRestaurant(resource.data.restaurantId));
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if signedIn()
        && (isSuperAdmin()
          || ownsRestaurant(resource.data.restaurantId)
          || (resource.data.customerId == request.auth.uid
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])));
      allow delete: if isSuperAdmin();
    }

    match /reservations/{reservationId} {
      allow read: if signedIn()
        && (isSuperAdmin()
          || resource.data.customerId == request.auth.uid
          || ownsRestaurant(resource.data.restaurantId));
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if signedIn()
        && (isSuperAdmin()
          || ownsRestaurant(resource.data.restaurantId)
          || (resource.data.customerId == request.auth.uid
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])));
      allow delete: if isSuperAdmin();
    }

    match /favorites/{favoriteId} {
      allow read: if signedIn() && resource.data.customerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.customerId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSuperAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }
  }
}
