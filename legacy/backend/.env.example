# DineConnect Backend Environment Configuration
# Copy this file to .env and replace placeholders with your real values.

# Local server settings
PORT=5000
NODE_ENV=development

# Database (local MongoDB)
MONGO_URI=mongodb://localhost:27017/dineconnect

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=changemen0w
# Token expiry
JWT_EXPIRES_IN=7d

# Frontend URL (for password reset + email-change links)
# Local: http://localhost:5173
# Firebase Hosting: https://dineconnect-36bc7.web.app
FRONTEND_URL=http://localhost:5173

# Email — Resend (https://resend.com/api-keys)
# Without a key, password resets & verification codes log to the server console
# instead of being sent. Set this to a real key in production.
RESEND_API_KEY=changemet00
# The "From" address must use a domain you've verified in Resend.
# The default onboarding@resend.dev only delivers to the Resend account owner.
EMAIL_FROM=onboarding@resend.dev
