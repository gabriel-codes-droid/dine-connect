# DineConnect Backend Environment Configuration
# Copy this file to .env and replace with your actual values

# Server (must match VITE_API_URL port in frontend/.env)
PORT=8001
NODE_ENV=development

# Database (local MongoDB)
MONGO_URI=mongodb://localhost:27017/dineconnect

# JWT Secret (generate with node -e)
JWT_SECRET=changemen0w
# Token expiry
JWT_EXPIRES_IN=7d

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# Email (Resend)
EMAIL_SERVICE=resend
RESEND_API_KEY=changemet00
